# Supabase (Project Settings → API). Lokálně vypíše `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Jen na serveru! Nikdy neprefixovat NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Veřejná adresa aplikace (odkazy v e-mailech, QR kódy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Doména technických účtů zaměstnanců (nikdy se na ni neposílá pošta)
EMPLOYEE_EMAIL_DOMAIN=employees.invalid

# Upozornění e-mailem (fáze 4)
RESEND_API_KEY=
ALERT_FROM_EMAIL="HACCP deník <upozorneni@vase-domena.cz>"
# Vercel Cron posílá Authorization: Bearer $CRON_SECRET
CRON_SECRET=
